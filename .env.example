# Supabase configuration (leave blank if using local mode)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Set VITE_API_URL to enable local/self-hosted mode
# When set, the app talks to the local Hono API server instead of Supabase.
# Use /api when running behind the nginx reverse proxy (Docker), or
# http://localhost:3000 for direct dev server access.
# VITE_API_URL=/api

# Web Push VAPID Public Key
# Generate your own key pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
