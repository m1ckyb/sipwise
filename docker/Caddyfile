# SipWise Caddyfile
# Automatic HTTPS via Let's Encrypt when DOMAIN is set to a real hostname.
# Uses Caddy's internal CA for local development (localhost / IP).

{$DOMAIN:localhost} {
    # Proxy all API traffic to the backend
    @api path /api/*
    reverse_proxy @api api:3000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Cache immutable build assets
    @assets path /assets/*
    header @assets Cache-Control "public, immutable, max-age=31536000"

    # Serve SPA — fall back to /index.html for unknown paths
    root * /usr/share/caddy
    try_files {path} /index.html
    file_server

    # Security headers (CSP is set by the API server for API responses;
    # these apply to all static responses from Caddy)
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "geolocation=(), camera=(), microphone=()"
        -Server
    }
}
