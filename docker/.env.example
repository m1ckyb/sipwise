# PostgreSQL
POSTGRES_PASSWORD=sipwise

# JWT secret — MUST be >= 32 chars, change in production
JWT_SECRET=change-me-to-a-real-secret-min-32-chars

# VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Frontend API URL (relative path works behind nginx reverse proxy)
VITE_API_URL=/api

# Frontend port
PORT=8080

# Comma-separated list of allowed origins (for CORS and CSRF)
ALLOWED_ORIGINS=http://localhost:8080

# bcrypt hashing rounds (default: 12, higher = slower but more secure)
BCRYPT_ROUNDS=12

# Server log level: debug, info, warn, error
LOG_LEVEL=info

# --- TLS (OPTIONAL) ---
# For production, terminate TLS in front of the stack using one of:
#
# 1. Caddy (easiest, auto-TLS):
#    Add to Caddyfile:
#    yourdomain.com {
#      reverse_proxy frontend:80
#    }
#    Add `caddy` service to docker-compose.yml and put frontend on internal network.
#
# 2. Nginx with Let's Encrypt:
#    Replace nginx.conf with TLS-enabled config using certbot certificates.
#    Mount certs via volumes: ./certs:/etc/nginx/certs
#
# 3. Cloudflare Tunnel:
#    Run cloudflared in docker-compose to tunnel without opening ports.
#
# 4. External reverse proxy (Traefik, HAProxy, etc.):
#    Point your proxy at the frontend container on port 80.
#
# When TLS is terminated upstream, set:
#   ALLOWED_ORIGINS=https://yourdomain.com
