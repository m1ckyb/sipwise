# PostgreSQL
POSTGRES_PASSWORD=sipwise

# JWT secret — MUST change in production
JWT_SECRET=change-me-in-production

# VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Frontend API URL (relative path works behind nginx reverse proxy)
VITE_API_URL=/api

# Frontend port
PORT=8080
